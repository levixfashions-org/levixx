datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id          String     @id @default(uuid())
  firebaseUid String     @unique
  email       String     @unique
  name        String?
  phone       String?
  role        Role       @default(CUSTOMER)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  addresses   Address[]
  orders      Order[]
  cart        Cart?
  wishlist    Wishlist?
  reviews     Review[]

  @@index([firebaseUid])
  @@index([email])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   @db.Text
  sortOrder   Int       @default(0)
  group       String?   // TOP | BOTTOM | ACCESSORIES (used by the mega menu)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id              String              @id @default(uuid())
  name            String
  slug            String              @unique
  description     String?             @db.Text
  bannerImageUrl  String?             @db.Text
  mobileBannerUrl String?             @db.Text
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  homeLayout      String              @default("NONE") // NONE | CAROUSEL | GRID — how it appears on the homepage
  showInGallery   Boolean             @default(false)  // appears in the homepage banner slideshow
  showInMenu      Boolean             @default(true)
  products        CollectionProduct[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Product {
  id           String              @id @default(uuid())
  name         String
  slug         String              @unique
  description  String              @db.Text
  details      String?             @db.Text
  fabricCare   String?             @db.Text
  fitGuide     String?             @db.Text
  basePrice    Int                 // Stored in paise (e.g. 499000 paise = Rs. 4,990)
  comparePrice Int?                // Compare at price in paise
  isFeatured   Boolean             @default(false)
  isActive     Boolean             @default(true)
  colorGroup   String?             // e.g. BLACKS, BLUES — powers "Shop by colour"
  gender       String              @default("UNISEX") @db.VarChar(10) // MEN | WOMEN | UNISEX
  categoryId   String?
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  collections  CollectionProduct[]
  orderItems   OrderItem[]
  wishlistItems WishlistItem[]
  reviews      Review[]
  position     Int                 @default(0) // Manual display order set in Admin → Products (lower shows first; 0 = new, shows on top)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([slug])
  @@index([position])
  @@index([categoryId])
  @@index([gender])
}

model CollectionProduct {
  id           String     @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  altText   String?
  color     String?  // which colour this photo shows (null = all colours)
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String      // "S", "M", "L", "XL", "XXL", "30", "32", "34", "36"
  color         String?     // e.g. "Black" — null when the product has a single colour
  colorHex      String?     // e.g. "#111111" for the swatch
  sku           String      @unique
  stockQuantity Int         @default(0)
  priceDelta    Int         @default(0) // paise offset from basePrice
  cartItems     CartItem[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
}

model Cart {
  id             String     @id @default(uuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousToken String?    @unique
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
}

model Order {
  id                      String        @id @default(uuid())
  orderNumber             String        @unique // e.g. "LVX-261110-A7K2Q9"
  userId                  String?
  user                    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail           String
  customerName            String
  customerPhone           String
  shippingAddressSnapshot Json          // Snapshot of address at time of purchase
  subtotalPaise           Int
  shippingPaise           Int           @default(0)
  discountPaise           Int           @default(0)
  totalPaise              Int
  status                  OrderStatus   @default(PENDING)
  paymentStatus           PaymentStatus @default(PENDING)
  razorpayOrderId         String?       @unique
  paymentMethod           String        @default("ONLINE") @db.VarChar(10) // ONLINE | COD
  codFeePaise             Int           @default(0)
  couponCode              String?
  cartId                  String?
  accessKey               String?       // secret key so guest buyers can view their own order
  courier                 String?
  trackingNumber          String?
  adminNotes              String?       @db.Text
  stockDeducted           Boolean       @default(false)
  paidAt                  DateTime?
  payment                 Payment?
  items                   OrderItem[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([customerEmail])
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName    String
  productSlug    String
  size           String
  color          String?
  unitPricePaise Int
  quantity       Int
  subtotalPaise  Int
  imageUrl       String?         @db.Text
  createdAt      DateTime        @default(now())

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountPaise       Int
  currency          String        @default("INR")
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int          // percentage (e.g. 10 for 10%) or fixed paise (e.g. 50000 for Rs. 500)
  minOrderPaise Int          @default(0)
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  validUntil    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
}

model StoreSetting {
  id                    String   @id @default("default")
  announcementText      String   @db.Text
  heroHeadline          String
  heroSubtitle          String   @db.Text
  supportEmail          String
  supportPhone          String   @default("")
  instagramHandle       String   @default("")
  freeShippingThreshold Int      @default(1999) // rupees
  shippingFee           Int      @default(150)  // rupees
  announcementEnabled   Boolean  @default(false)
  heroDesktopImage      String?  @db.Text
  heroMobileImage       String?  @db.Text
  heroDesktopVideo      String?  @db.Text
  heroMobileVideo       String?  @db.Text
  // Business & legal details shown on the policy / contact pages
  legalName             String?
  businessAddress       String?  @db.Text
  grievanceOfficer      String?
  gstin                 String?
  jurisdictionCity      String?
  // Cash on Delivery
  codEnabled            Boolean  @default(false)
  codFee                Int      @default(0)   // rupees
  codMaxOrder           Int      @default(0)   // rupees, 0 = no limit
  heroLink              String   @default("/collections/all-products")
  heroCtaText           String   @default("Shop now")
  latestDropTitle       String   @default("Latest drop")
  seoTitle              String?  @db.Text
  seoText               String?  @db.Text
  shippingInfo          String?  @db.Text
  careInfo              String?  @db.Text
  defaultsVersion       Int      @default(0)
  updatedAt             DateTime @default(now()) @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int      // 1 to 5
  comment    String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Images uploaded from the admin panel (stored in MySQL so redeploys never lose them).
model MediaFile {
  id        String   @id @default(uuid())
  mime      String
  size      Int
  width     Int?
  height    Int?
  fileName  String?
  data      Bytes    @db.LongBlob
  // Videos are stored in 4 MB pieces (MediaChunk) so big files never hit MySQL's packet limit.
  chunkCount Int     @default(0)
  complete   Boolean @default(true)
  createdAt DateTime @default(now())
}

model MediaChunk {
  mediaId String
  idx     Int
  data    Bytes  @db.LongBlob

  @@id([mediaId, idx])
}
