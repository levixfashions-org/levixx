NODE_ENV=production
PORT=4000
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
FRONTEND_URL=https://thelevix.shop

# Store owner(s) — must be a Firebase-verified email (e.g. sign in with Google)
ADMIN_EMAILS=levixfashions@gmail.com

# Firebase — the project id alone is enough to verify sign-ins
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional service account (not required):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Razorpay (required for checkout)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=long-random-string-you-also-enter-in-razorpay
